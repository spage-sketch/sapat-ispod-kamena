{
 "pack": "Gridwright Medieval Village",
 "version": "1.0",
 "grid": 16,
 "note": "Positions and sizes are for the 1x sheets; multiply by 2 or 3 for 2x and 3x.",
 "bitmask": "cobble: N=1, NE=2, E=4, SE=8, S=16, SW=32, W=64, NW=128; a diagonal counts only when both neighbours next to it are set",
 "fences": "stone wall and palisade joins: 1 = north, 2 = east, 4 = south, 8 = west",
 "roofs": "a roof is a block: the ridge row on top, any number of slope rows, the eave row at the bottom; left, middle and right pieces per row",
 "facades": "one facade row = one storey; left and right pieces carry the building corner",
 "animation": "frames are named _f1.._fN; suggested speed: windmill 6 fps, smoke 5, fountain 6, forge 8, brazier 8, flags 6",
 "big_pieces": "a piece bigger than 16x16 stands on its bottom row of cells",
 "prefabs": "ready-made buildings: day, lit (windows lit, for night scenes) and winter (snow roofs); recipe = the kit piece in every cell, row by row, and the extras placed on cells",
